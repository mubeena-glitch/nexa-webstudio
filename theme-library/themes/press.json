{
  "id": "press",
  "name": "Press",
  "family": "vibrant",
  "sector": "Magazine / events",
  "tags": [
    "retro",
    "print",
    "editorial",
    "bold-serif",
    "listings",
    "events"
  ],
  "mode": "light",
  "tokens": {
    "color": {
      "bg": "244 239 230",
      "surface": "255 253 247",
      "ink": "26 26 26",
      "muted": "107 99 87",
      "line": "26 26 26",
      "primary": "226 59 46",
      "onPrimary": "255 255 255",
      "accent": "43 95 163",
      "accent2": "43 95 163"
    },
    "type": {
      "display": "'DM Serif Display', ui-serif, Georgia, serif",
      "body": "'Space Mono', ui-monospace, 'SFMono-Regular', monospace",
      "scaleRatio": 1.414,
      "weights": {
        "display": 400,
        "displayBold": 400,
        "body": 400,
        "label": 700,
        "bold": 700
      },
      "displayCase": "none",
      "displayTracking": "-0.01em"
    },
    "space": {
      "base": 8,
      "section": "clamp(64px, 8vw, 112px)",
      "gutter": "clamp(16px, 4vw, 48px)",
      "density": "dense"
    },
    "radius": {
      "card": "4px",
      "button": "2px",
      "input": "2px",
      "pill": "2px"
    },
    "shadow": {
      "card": "4px 4px 0 rgb(43 95 163)",
      "elevated": "6px 6px 0 rgb(26 26 26)",
      "philosophy": "dramatic"
    },
    "motion": {
      "ease": "cubic-bezier(0.3, 1, 0.4, 1)",
      "duration": "160ms",
      "character": "snappy"
    },
    "imagery": {
      "treatment": "framed",
      "ratio": "4:3",
      "filter": "grayscale for portraits"
    }
  },
  "recipes": {
    "button": "solid-offset",
    "card": "bordered-offset",
    "nav": "masthead"
  },
  "preferredLayouts": {
    "hero": "cover-story-split",
    "listings": "day-columns",
    "features": "ticketed-cards",
    "picks": "lead-plus-list",
    "stats": "none",
    "cta": "subscription-band"
